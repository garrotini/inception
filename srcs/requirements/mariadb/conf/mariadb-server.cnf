# only MariaDB server read this groups and options

# read by the standalone daemon and embedded server
[server]

# this is only for the mysqld standalone daemon
[mysqld]

# no skip-networking, otherwise mariadb only connects to unix sockets
# here, it needs to connect via TCP to Wordpress living in another container

# listening on all interfaces, so Wordpress can request
bind-address = 0.0.0.0

# standard mariadb port
port = 3306

# unix socket path for local connections inside the container
# check health with: `mariadb -u root` or `mariadb-admin ping`
socket = /run/mysqld/mysqld.sock

# where the database files live giving PERSISTENCE to the container
datadir = /var/lib/mysql

# default charset. Wordpress expects utf8mb4
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

# InnoDB is already built-in by default
# InnoDB = transactions, row-level locking, crash recovery via redo/undo logs
# at runtime, test: `mariadb -u root -e "SELECT @@default_storage_engine;`
# after WP install, test: `mariadb -u root <db> -e "SHOW TABLE STATUS\G" | grep Engine`
default-storage-engine = InnoDB
